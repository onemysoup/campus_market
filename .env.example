# 微信小程序凭证（填入你的 AppId 和 AppSecret）
WECHAT_APPID=your-app-id-here
WECHAT_APPSECRET=your-app-secret-here

# JWT 令牌密钥（生产环境请更换为安全密钥）
JWT_KEY=dev-hmac-key-for-testing-only-not-for-production

# 数据库配置
ConnectionStrings__Default=Server=localhost;Port=3306;Database=cau_second_hand;User=root;Password=your_password;Charset=utf8mb4

# 取货码 HMAC 密钥（生产环境请更换）
TOKEN_HMAC_KEY=dev-hmac-key-for-pickup-codes

# SMTP 邮箱服务（用于发送 CAU 邮箱验证码）
# 默认 smtp.cau.edu.cn:465，如需覆盖可取消注释修改
# SMTP_HOST=smtp.cau.edu.cn/smtp.qq.com
# SMTP_PORT=465
# SMTP_USE_SSL=true
SMTP_USER=your-smtp-user@cau.edu.cn/@qq.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=your-smtp-user@cau.edu.cn/@qq.com
