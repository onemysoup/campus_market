# 微信小程序凭证（填入你的 AppId 和 AppSecret）
WECHAT_APPID=your-app-id-here
WECHAT_APPSECRET=your-app-secret-here
WECHAT_TEMPLATE_PURCHASE_SUCCESS=your-purchase-success-template-id-here

# JWT 令牌密钥（生产环境请更换为安全密钥）
JWT_KEY=dev-hmac-key-for-testing-only-not-for-production

# 取货码 HMAC 密钥（生产环境请更换）
TOKEN_HMAC_KEY=dev-hmac-key-for-pickup-codes

# SMTP 邮箱服务（用于发送 CAU 邮箱验证码）
# 默认 smtp.cau.edu.cn:465，如需覆盖可取消注释修改
# SMTP_HOST=smtp.cau.edu.cn
# SMTP_PORT=465
# SMTP_USE_SSL=true
SMTP_USER=your-smtp-user@cau.edu.cn
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=your-smtp-user@cau.edu.cn

# 可选：OpenAI 兼容 LLM 接口（商品图片描述 + 内容审核）
AI_ENABLED=false
AI_ENDPOINT=https://api.openai.com/v1/chat/completions
AI_API_KEY=your-ai-api-key-here
AI_MODEL=gpt-4o-mini
# 可留空，留空时复用 AI_ENDPOINT
AI_MODERATION_ENDPOINT=
AI_MODERATION_MODEL=gpt-4o-mini
