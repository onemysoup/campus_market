# Improve GitHub Linguist classification for WeChat Mini Program files
*.wxml linguist-language=HTML
*.wxss linguist-language=CSS

# Treat EF Core migrations as auto-generated
src/Infrastructure/Migrations/*.Designer.cs linguist-generated=true
src/Infrastructure/Migrations/AppDbContextModelSnapshot.cs linguist-generated=true

# Shell scripts must use LF line endings
.githooks/** text eol=lf
