.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: calc(108rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  align-items: center;
  background: #fff;
  border-top: 1rpx solid #dbe4ea;
  box-shadow: 0 -8rpx 24rpx rgba(15, 23, 42, 0.06);
  z-index: 999;
}

.tab-item {
  flex: 1;
  height: 108rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #0f172a;
}

.tab-item.active {
  color: #0f766e;
}

.tab-text {
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1;
}

.tab-item.active .tab-text {
  font-weight: 700;
}
