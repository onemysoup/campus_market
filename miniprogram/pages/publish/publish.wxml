<view class="container">
  <!-- 基本信息 -->
  <view class="section">
    <view class="section-title">基本信息</view>

    <!-- 标题 -->
    <view class="form-item">
      <text class="label">标题 <text class="required">*</text></text>
      <input
        class="input"
        placeholder="请输入商品标题（2-50字）"
        maxlength="50"
        value="{{form.title}}"
        bindinput="onTitleInput"
      />
    </view>

    <!-- 价格 -->
    <view class="form-item">
      <text class="label">价格 <text class="required">*</text></text>
      <view class="price-input-wrap">
        <text class="price-symbol">¥</text>
        <input
          class="input price-input"
          type="digit"
          placeholder="0.00"
          value="{{form.price}}"
          disabled="{{form.isFree}}"
          bindinput="onPriceInput"
        />
      </view>
    </view>

    <!-- 0元赠送 -->
    <view class="form-item switch-item">
      <text class="label">0元赠送</text>
      <switch checked="{{form.isFree}}" bindchange="onFreeChange" color="#0f766e" />
    </view>

    <!-- 可议价 -->
    <view class="form-item switch-item">
      <text class="label">可议价</text>
      <switch checked="{{form.isNegotiable}}" bindchange="onNegotiableChange" color="#0f766e" />
    </view>

    <!-- 租赁 -->
    <view class="form-item switch-item">
      <text class="label">租赁商品</text>
      <switch checked="{{form.isRental}}" bindchange="onRentalChange" color="#0f766e" />
    </view>

    <!-- 租金 / 押金（仅租赁商品显示） -->
    <block wx:if="{{form.isRental}}">
      <view class="form-item">
        <text class="label">租金</text>
        <input class="input" placeholder="如：3元/天" value="{{form.rentalRate}}" bindinput="onRentalRateInput" />
      </view>
      <view class="form-item">
        <text class="label">押金</text>
        <input class="input" type="digit" placeholder="押金金额（元）" value="{{form.deposit}}" bindinput="onDepositInput" />
      </view>
    </block>
  </view>

  <!-- 商品属性 -->
  <view class="section">
    <view class="section-title">商品属性</view>

    <!-- 分类 -->
    <view class="form-item">
      <text class="label">分类</text>
      <picker mode="selector" range="{{categories}}" range-key="name" value="{{categoryIndex}}" bindchange="onCategoryChange">
        <view class="picker-value">
          {{categories[categoryIndex].name}}
          <text class="picker-arrow">▼</text>
        </view>
      </picker>
    </view>

    <!-- 成色 -->
    <view class="form-item">
      <text class="label">成色</text>
      <picker mode="selector" range="{{conditions}}" range-key="name" value="{{conditionIndex}}" bindchange="onConditionChange">
        <view class="picker-value">
          {{conditions[conditionIndex].name}}
          <text class="picker-arrow">▼</text>
        </view>
      </picker>
    </view>

    <!-- 校区 -->
    <view class="form-item">
      <text class="label">校区</text>
      <picker mode="selector" range="{{campusOptions}}" range-key="label" value="{{campusIndex}}" bindchange="onCampusChange">
        <view class="picker-value">
          {{campusOptions[campusIndex].label}}
          <text class="picker-arrow">▼</text>
        </view>
      </picker>
    </view>

    <!-- 学院标签（可选） -->
    <view class="form-item">
      <text class="label">关联学院</text>
      <picker mode="selector" range="{{colleges}}" range-key="name" value="{{collegeIndex}}" bindchange="onCollegeChange">
        <view class="picker-value">
          {{colleges[collegeIndex].name}}
          <text class="picker-arrow">▼</text>
        </view>
      </picker>
    </view>
  </view>

  <!-- 商品描述 -->
  <view class="section">
    <view class="section-title">商品描述</view>
    <textarea
      class="textarea"
      placeholder="请详细描述商品的成色、使用情况、交易方式等..."
      maxlength="500"
      value="{{form.description}}"
      bindinput="onDescInput"
    />
    <view class="textarea-count">{{form.description.length}}/500</view>
  </view>

  <!-- 商品图片 -->
  <view class="section">
    <view class="section-title">
      商品图片
      <text class="required">*</text>
      <text class="image-count">{{form.images.length}}/{{maxImages}}</text>
    </view>

    <view class="image-grid">
      <!-- 已上传图片 -->
      <view class="image-item" wx:for="{{form.images}}" wx:key="*this">
        <image
          class="image-thumb"
          src="{{item}}"
          mode="aspectFill"
          bindtap="onPreviewImage"
          data-src="{{item}}"
        />
        <view class="image-delete" catchtap="onDeleteImage" data-index="{{index}}">✕</view>
      </view>

      <!-- 添加图片按钮 -->
      <view class="image-add" wx:if="{{form.images.length < maxImages}}" bindtap="onChooseImage">
        <text class="add-icon">+</text>
        <text class="add-text">添加图片</text>
      </view>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-section">
    <button
      class="btn-submit {{submitting ? 'disabled' : ''}}"
      loading="{{submitting}}"
      disabled="{{submitting}}"
      bindtap="onSubmit"
    >
      {{editMode ? '保存修改' : '立即发布'}}
    </button>
  </view>
</view>
