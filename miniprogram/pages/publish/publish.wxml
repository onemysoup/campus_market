<view class="container">
  <view class="card">
    <input class="input" placeholder="标题" value="{{form.title}}" data-key="title" bindinput="onInput" />
    <input class="input" placeholder="价格" type="digit" value="{{form.price}}" data-key="price" bindinput="onInput" />

    <picker mode="selector" range="{{categories}}" range-key="name" bindchange="onCategoryChange">
      <view class="input">分类：{{categoryLabel}}</view>
    </picker>

    <picker mode="selector" range="{{conditions}}" range-key="name" bindchange="onConditionChange">
      <view class="input">成色：{{conditionLabel}}</view>
    </picker>

    <textarea class="input" placeholder="商品描述" value="{{form.description}}" data-key="description" bindinput="onInput" />

    <view class="img-row">
      <button size="mini" bindtap="chooseImages">选择图片(最多6张)</button>
      <text>{{form.images.length}} / 6</text>
    </view>
    <view class="img-list">
      <image wx:for="{{form.images}}" wx:key="index" src="{{item}}" class="img" mode="aspectFill" />
    </view>

    <button class="btn-primary" loading="{{loading}}" bindtap="onSubmit">{{goodsId ? '保存编辑' : '立即发布'}}</button>
  </view>
</view>
