.container {
  min-height: 100vh;
  background: #f8fafc;
}

/* ==================== 搜索栏 ==================== */
.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #f1f5f9;
  position: sticky;
  top: 0;
  z-index: 100;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f1f5f9;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.clear-btn {
  font-size: 28rpx;
  color: #94a3b8;
  padding: 8rpx;
}

.filter-btn {
  padding: 12rpx 24rpx;
  background: #f0fdfa;
  color: #0f766e;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.filter-btn.active {
  background: #0f766e;
  color: #fff;
}

/* ==================== 筛选面板 ==================== */
.filter-panel {
  background: #fff;
  padding: 0 24rpx;
  max-height: 0;
  overflow: hidden;
  transition: all 0.3s ease;
}

.filter-panel.show {
  max-height: 500rpx;
  padding: 24rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.filter-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.filter-label {
  width: 100rpx;
  font-size: 26rpx;
  color: #475569;
  font-weight: 500;
}

.filter-picker {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 16rpx;
  background: #f8fafc;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #334155;
}

.picker-arrow {
  font-size: 20rpx;
  color: #94a3b8;
}

.price-range {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.price-input {
  flex: 1;
  padding: 12rpx 16rpx;
  background: #f8fafc;
  border-radius: 8rpx;
  font-size: 26rpx;
  text-align: center;
}

.price-sep {
  color: #94a3b8;
}

.price-confirm {
  background: #0f766e;
  color: #fff;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
}

.filter-actions {
  display: flex;
  justify-content: center;
  padding-top: 12rpx;
}

.btn-reset {
  background: #f1f5f9;
  color: #64748b;
  font-size: 26rpx;
  padding: 12rpx 48rpx;
  border-radius: 8rpx;
}

/* ==================== 筛选标签 ==================== */
.active-filters {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #f1f5f9;
}

.filter-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  background: #0f766e;
  color: #fff;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.tag-close {
  font-size: 20rpx;
  opacity: 0.8;
}

/* ==================== 商品列表 ==================== */
.goods-list {
  padding: 16rpx 24rpx;
}

.goods-item {
  display: flex;
  padding: 20rpx;
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s;
}

.goods-item:active {
  transform: scale(0.98);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.08);
}

.goods-thumb {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  background: #f1f5f9;
  flex-shrink: 0;
}

.goods-meta {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.4;
}

.goods-info {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.category-tag {
  background: #f0fdfa;
  color: #0f766e;
}

.status-tag {
  font-weight: 500;
}

.goods-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}

.goods-price {
  font-size: 36rpx;
  font-weight: 700;
  color: #dc2626;
}

.rental-tag {
  display: inline-block;
  margin-left: 8rpx;
  padding: 2rpx 10rpx;
  font-size: 20rpx;
  font-weight: 500;
  color: #b45309;
  background: #fef3c7;
  border-radius: 6rpx;
  vertical-align: middle;
}

.goods-time {
  font-size: 22rpx;
  color: #94a3b8;
}

/* ==================== 加载状态 ==================== */
.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 32rpx 0;
  color: #64748b;
  font-size: 26rpx;
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid #e2e8f0;
  border-top-color: #0f766e;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.no-more {
  text-align: center;
  padding: 32rpx 0;
  color: #94a3b8;
  font-size: 24rpx;
}

/* ==================== 骨架屏 ==================== */
.skeleton-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.skeleton-item {
  display: flex;
  padding: 20rpx;
  background: #fff;
  border-radius: 16rpx;
}

.skeleton-thumb {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  background: linear-gradient(90deg, #f1f5f9 25%, #e2e8f0 50%, #f1f5f9 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}

.skeleton-meta {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.skeleton-title {
  height: 36rpx;
  width: 80%;
  background: linear-gradient(90deg, #f1f5f9 25%, #e2e8f0 50%, #f1f5f9 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: 6rpx;
}

.skeleton-info {
  height: 24rpx;
  width: 40%;
  background: linear-gradient(90deg, #f1f5f9 25%, #e2e8f0 50%, #f1f5f9 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: 6rpx;
}

.skeleton-price {
  height: 40rpx;
  width: 30%;
  background: linear-gradient(90deg, #f1f5f9 25%, #e2e8f0 50%, #f1f5f9 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: 6rpx;
}

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ==================== 空状态 ==================== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 28rpx;
  color: #94a3b8;
  margin-bottom: 24rpx;
}

.btn-empty-reset {
  background: #0f766e;
  color: #fff;
  font-size: 28rpx;
  padding: 16rpx 48rpx;
  border-radius: 12rpx;
}
