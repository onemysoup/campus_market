.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 顶部 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 30rpx;
  background: #fff;
}
.header-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2937;
}
.btn-publish {
  background: #0f766e;
  color: #fff;
  font-size: 26rpx;
  border-radius: 30rpx;
}

/* 列表 */
.req-list {
  padding: 20rpx 24rpx;
}
.req-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.req-top {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}
.req-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  flex: 1;
}
.req-urgent {
  background: #fee2e2;
  color: #dc2626;
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  margin-left: 12rpx;
}
.req-meta {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.req-tag {
  background: #ecfdf5;
  color: #0f766e;
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
}
.req-price {
  font-size: 26rpx;
  color: #ef4444;
}
.req-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.req-time {
  font-size: 22rpx;
  color: #9ca3af;
}
.req-actions {
  display: flex;
  gap: 12rpx;
}
.req-btn {
  font-size: 24rpx;
  background: #f3f4f6;
  color: #374151;
  border-radius: 24rpx;
  margin: 0;
}
.req-btn.primary {
  background: #0f766e;
  color: #fff;
}
.req-btn.danger {
  background: #fef2f2;
  color: #dc2626;
}

/* 空状态 */
.empty {
  padding: 120rpx 0;
  text-align: center;
}
.empty-text {
  font-size: 28rpx;
  color: #9ca3af;
}
.loading-more,
.no-more {
  text-align: center;
  font-size: 24rpx;
  color: #9ca3af;
  padding: 24rpx 0;
}

/* 发布弹窗 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
}
.publish-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 30rpx;
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.25s ease;
}
.publish-sheet.show {
  transform: translateY(0);
}
.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 24rpx;
}
.sheet-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.sheet-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #374151;
}
.sheet-input {
  flex: 1;
  font-size: 28rpx;
}
.sheet-picker {
  flex: 1;
  font-size: 28rpx;
  color: #1f2937;
}
.switch-item {
  justify-content: space-between;
}
.sheet-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}
.sheet-btn {
  flex: 1;
  border-radius: 40rpx;
  font-size: 30rpx;
}
.sheet-btn.cancel {
  background: #f3f4f6;
  color: #374151;
}
.sheet-btn.confirm {
  background: #0f766e;
  color: #fff;
}
