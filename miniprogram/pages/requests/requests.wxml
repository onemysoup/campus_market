<view class="page">
  <!-- 顶部发布按钮 -->
  <view class="header">
    <text class="header-title">求购大厅</text>
    <button class="btn-publish" size="mini" bindtap="openPublish">＋ 发布求购</button>
  </view>

  <!-- 求购列表 -->
  <view class="req-list" wx:if="{{list.length > 0}}">
    <view class="req-card" wx:for="{{list}}" wx:key="requestId">
      <view class="req-top">
        <text class="req-title">{{item.title}}</text>
        <text class="req-urgent" wx:if="{{item.isUrgent}}">急求</text>
      </view>
      <view class="req-meta">
        <text class="req-tag">{{item.resourceText}}</text>
        <text class="req-price" wx:if="{{item.maxPrice}}">预算 ¥{{item.maxPrice}}</text>
        <text class="req-price" wx:else>价格面议</text>
      </view>
      <view class="req-bottom">
        <text class="req-time">{{item.timeText}} · {{item.matchingCount}} 人响应</text>
        <view class="req-actions">
          <!-- 别人的帖子：可响应 -->
          <button wx:if="{{!item.isMine}}" class="req-btn primary" size="mini" data-id="{{item.requestId}}" bindtap="onRespond">我有</button>
          <!-- 自己的帖子：可续期、关闭 -->
          <block wx:if="{{item.isMine}}">
            <button class="req-btn" size="mini" data-id="{{item.requestId}}" bindtap="onRenew">续期</button>
            <button class="req-btn danger" size="mini" data-id="{{item.requestId}}" bindtap="onClose">关闭</button>
          </block>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{!loading && list.length === 0}}">
    <text class="empty-text">还没有求购信息，发一条试试吧～</text>
  </view>

  <view class="loading-more" wx:if="{{loadingMore}}">加载中...</view>
  <view class="no-more" wx:if="{{!hasMore && list.length > 0}}">没有更多了</view>

  <!-- 发布弹窗 -->
  <view class="mask" wx:if="{{showPublish}}" bindtap="closePublish"></view>
  <view class="publish-sheet {{showPublish ? 'show' : ''}}">
    <view class="sheet-title">发布求购</view>

    <view class="sheet-item">
      <text class="sheet-label">求购内容</text>
      <input class="sheet-input" placeholder="如：求购一本高等数学教材" value="{{form.title}}" bindinput="onTitleInput" />
    </view>

    <view class="sheet-item">
      <text class="sheet-label">最高预算</text>
      <input class="sheet-input" type="digit" placeholder="选填，单位元" value="{{form.maxPrice}}" bindinput="onMaxPriceInput" />
    </view>

    <view class="sheet-item">
      <text class="sheet-label">分类</text>
      <picker mode="selector" range="{{resourceTypes}}" range-key="name" value="{{form.resourceIndex}}" bindchange="onResourceChange">
        <view class="sheet-picker">{{resourceTypes[form.resourceIndex].name}} ▼</view>
      </picker>
    </view>

    <view class="sheet-item">
      <text class="sheet-label">校区</text>
      <picker mode="selector" range="{{campusOptions}}" range-key="label" value="{{form.campusIndex}}" bindchange="onCampusChange">
        <view class="sheet-picker">{{campusOptions[form.campusIndex].label}} ▼</view>
      </picker>
    </view>

    <view class="sheet-item switch-item">
      <text class="sheet-label">急求</text>
      <switch checked="{{form.isUrgent}}" bindchange="onUrgentChange" color="#0f766e" />
    </view>

    <view class="sheet-actions">
      <button class="sheet-btn cancel" bindtap="closePublish">取消</button>
      <button class="sheet-btn confirm" loading="{{submitting}}" bindtap="onSubmit">发布</button>
    </view>
  </view>
</view>
