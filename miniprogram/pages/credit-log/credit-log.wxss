.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
  box-sizing: border-box;
}

.score-card {
  background: linear-gradient(135deg, #0f766e, #14b8a6);
  border-radius: 20rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #fff;
  margin-bottom: 24rpx;
}

.score-label {
  font-size: 26rpx;
  opacity: 0.9;
}

.score-value {
  font-size: 80rpx;
  font-weight: 700;
  line-height: 1.2;
  margin: 8rpx 0;
}

.score-hint {
  font-size: 20rpx;
  opacity: 0.85;
  text-align: center;
}

.log-list {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.log-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.log-item:last-child {
  border-bottom: none;
}

.log-main {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.log-reason {
  font-size: 28rpx;
  color: #1f2937;
}

.log-time {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 6rpx;
}

.log-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.log-amount {
  font-size: 32rpx;
  font-weight: 700;
}

.log-amount.plus {
  color: #22c55e;
}

.log-amount.minus {
  color: #ef4444;
}

.log-after {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 6rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #94a3b8;
  margin-top: 16rpx;
}

.no-more {
  text-align: center;
  font-size: 22rpx;
  color: #cbd5e1;
  padding: 32rpx 0;
}
