<view class="container">
  <app-nav title="{{targetNickname || '聊天'}}" showBack />
  <!-- 吸顶商品信息条 -->
  <view class="item-bar" wx:if="{{itemInfo}}" bindtap="onTapItem">
    <image class="item-thumb" src="{{itemInfo.image}}" mode="aspectFill" />
    <view class="item-info">
      <text class="item-title">{{itemInfo.title}}</text>
      <view class="item-meta">
        <text class="item-price">{{itemInfo.priceDisplay}}</text>
        <text class="item-status {{itemInfo.status === 1 ? 'on-sale' : 'sold'}}">{{itemInfo.statusText}}</text>
      </view>
    </view>
    <text class="item-arrow">›</text>
  </view>

  <!-- 安全交易贴士（F4.5.1） + 拉黑入口 -->
  <view class="tip-row">
    <view class="safety-tip">🔔 本校仅限面交，公共场合交易，切勿提前转账！</view>
    <text class="report-btn" bindtap="onReportUser">举报</text>
    <text class="block-btn" bindtap="onBlockUser">🚫 拉黑</text>
  </view>

  <!-- 跨区交易提醒（F4.4.2） -->
  <view class="cross-tip-bar" wx:if="{{showCrossTip}}">⚠️ 该商品位于不同校区，平台不提供配送，请双方私下协商交付，风险自担。</view>

  <!-- 消息列表 -->
  <scroll-view
    class="message-list"
    scroll-y
    scroll-into-view="{{scrollToView}}"
    scroll-with-animation
    enhanced
    show-scrollbar="{{false}}"
  >
    <!-- 加载中 -->
    <view class="loading-more" wx:if="{{loadingMessages}}">
      <view class="loading-spinner"></view>
      <text>加载中...</text>
    </view>

    <!-- 消息流 -->
    <view
      class="message-item {{item.isMine ? 'mine' : 'other'}}"
      wx:for="{{messages}}"
      wx:key="messageId"
      id="{{item.messageId}}"
    >
      <!-- 时间分割线（每10分钟显示一次） -->
      <view class="time-divider" wx:if="{{index === 0}}">
        <text>{{item.timeText}}</text>
      </view>

      <!-- 对方消息 -->
      <block wx:if="{{!item.isMine}}">
        <view class="msg-content-wrap">
          <image
            wx:if="{{item.msgType === 1}}"
            class="msg-image"
            src="{{item.content}}"
            mode="widthFix"
            data-src="{{item.content}}"
            bindtap="onPreviewMessageImage"
          />
          <view wx:else class="msg-bubble other-bubble">
            <text>{{item.content}}</text>
          </view>
        </view>
      </block>

      <!-- 我的消息 -->
      <block wx:if="{{item.isMine}}">
        <view class="msg-content-wrap mine-wrap">
          <image
            wx:if="{{item.msgType === 1}}"
            class="msg-image"
            src="{{item.content}}"
            mode="widthFix"
            data-src="{{item.content}}"
            bindtap="onPreviewMessageImage"
          />
          <view wx:else class="msg-bubble mine-bubble">
            <text>{{item.content}}</text>
          </view>
        </view>
      </block>
    </view>

    <!-- 底部锚点 -->
    <view id="msg_bottom"></view>
  </scroll-view>

  <!-- 校园快捷短语（F4.1.1） -->
  <scroll-view class="quick-phrases" scroll-x show-scrollbar="{{false}}">
    <text
      class="quick-phrase"
      wx:for="{{quickPhrases}}"
      wx:key="*this"
      data-text="{{item}}"
      bindtap="onQuickPhrase"
    >{{item}}</text>
  </scroll-view>

  <!-- 输入区域 -->
  <view class="input-area">
    <view class="btn-image" bindtap="onChooseImage">📷</view>
    <view class="input-wrap">
      <input
        class="msg-input"
        placeholder="输入消息..."
        value="{{inputContent}}"
        bindinput="onInputChange"
        bindconfirm="onSend"
        adjust-position
      />
    </view>
    <button
      class="btn-send {{canSend ? 'active' : ''}}"
      disabled="{{!canSend}}"
      bindtap="onSend"
    >
      发送
    </button>
  </view>
</view>
