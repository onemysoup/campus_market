.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}

/* ==================== 吸顶商品信息条 ==================== */
.item-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #f1f5f9;
  flex-shrink: 0;
}

.item-bar:active {
  background: #f8fafc;
}

.item-thumb {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  background: #f1f5f9;
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  margin: 0 16rpx;
  overflow: hidden;
}

.item-title {
  font-size: 26rpx;
  font-weight: 500;
  color: #334155;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}

.item-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 6rpx;
}

.item-price {
  font-size: 28rpx;
  font-weight: 700;
  color: #dc2626;
}

.item-status {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.item-status.on-sale {
  background: #dcfce7;
  color: #16a34a;
}

.item-status.sold {
  background: #f1f5f9;
  color: #94a3b8;
}

.item-arrow {
  font-size: 36rpx;
  color: #cbd5e1;
  flex-shrink: 0;
}

/* ==================== 消息列表 ==================== */
.message-list {
  flex: 1;
  padding: 24rpx 0;
  overflow-y: auto;
}

.message-item {
  display: flex;
  margin-bottom: 24rpx;
  padding: 0 24rpx;
}

.message-item.mine {
  justify-content: flex-end;
}

/* 时间分割线 */
.time-divider {
  width: 100%;
  text-align: center;
  margin-bottom: 24rpx;
}

.time-divider text {
  font-size: 22rpx;
  color: #94a3b8;
  background: rgba(0, 0, 0, 0.05);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.msg-content-wrap {
  max-width: 65%;
}

.mine-wrap {
  display: flex;
  justify-content: flex-end;
}

.msg-bubble {
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-all;
}

.other-bubble {
  background: #fff;
  color: #334155;
  border-top-left-radius: 4rpx;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.05);
}

.mine-bubble {
  background: linear-gradient(135deg, #0f766e, #14b8a6);
  color: #fff;
  border-top-right-radius: 4rpx;
}

/* ==================== 输入区域 ==================== */
.input-area {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #f1f5f9;
  flex-shrink: 0;
}

.input-wrap {
  flex: 1;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
}

.msg-input {
  font-size: 28rpx;
  height: 44rpx;
  width: 100%;
}

.btn-send {
  min-width: 120rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: #cbd5e1;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 12rpx;
  border: none;
}

.btn-send::after {
  border: none;
}

.btn-send.active {
  background: linear-gradient(135deg, #0f766e, #14b8a6);
}

.btn-send:active.active {
  opacity: 0.9;
}

/* ==================== 加载状态 ==================== */
.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 32rpx 0;
  color: #64748b;
  font-size: 26rpx;
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid #e2e8f0;
  border-top-color: #0f766e;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
