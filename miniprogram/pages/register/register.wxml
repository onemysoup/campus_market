<view class="container">
  <view class="switcher">
    <view class="{{mode==='register'?'active':''}}" bindtap="switchMode" data-mode="register">注册</view>
    <view class="{{mode==='reset'?'active':''}}" bindtap="switchMode" data-mode="reset">修改密码</view>
  </view>

  <view class="card" wx:if="{{mode==='register'}}">
    <input class="input" placeholder="昵称" value="{{form.nickname}}" data-key="nickname" bindinput="onInput" />
    <input class="input" placeholder="手机号" maxlength="11" value="{{form.phone}}" data-key="phone" bindinput="onInput" />
    <input class="input" placeholder="密码" password value="{{form.password}}" data-key="password" bindinput="onInput" />
    <picker mode="selector" range="{{roles}}" range-key="label" bindchange="onRoleChange">
      <view class="input">角色：{{roles[roleIndex].label}}</view>
    </picker>
    <input class="input" placeholder="学号" value="{{form.student_id}}" data-key="student_id" bindinput="onInput" />
    <input class="input" placeholder="学院" value="{{form.college}}" data-key="college" bindinput="onInput" />
    <button class="btn-primary" bindtap="onRegister">立即注册</button>
  </view>

  <view class="card" wx:if="{{mode==='reset'}}">
    <input class="input" placeholder="手机号" maxlength="11" value="{{reset.phone}}" data-key="phone" bindinput="onResetInput" />
    <input class="input" placeholder="验证码(演示:123456)" value="{{reset.code}}" data-key="code" bindinput="onResetInput" />
    <input class="input" placeholder="新密码" password value="{{reset.newPassword}}" data-key="newPassword" bindinput="onResetInput" />
    <button class="btn-primary" bindtap="onReset">确认修改</button>
  </view>
</view>
