<view class="container">
  <app-nav title="我发布的商品" showBack />
  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{loading && list.length === 0}}">
    <view class="skeleton-item" wx:for="{{[1,2,3]}}" wx:key="*this">
      <view class="skeleton-thumb"></view>
      <view class="skeleton-meta">
        <view class="skeleton-title"></view>
        <view class="skeleton-price"></view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:elif="{{!loading && list.length === 0}}">
    <text class="empty-icon">📦</text>
    <text class="empty-text">还没有发布商品</text>
    <button class="btn-publish" bindtap="goPublish">去发布</button>
  </view>

  <!-- 商品列表 -->
  <view class="goods-list" wx:else>
    <view class="goods-card" wx:for="{{list}}" wx:key="itemId">
      <!-- 商品信息（可点击查看详情） -->
      <view class="goods-info" data-id="{{item.itemId}}" bindtap="goDetail">
        <image wx:if="{{item.firstImage}}" class="goods-thumb" src="{{item.firstImage}}" mode="aspectFill" />
        <view wx:else class="goods-thumb thumb-placeholder">暂无图片</view>
        <view class="goods-meta">
          <view class="goods-title">{{item.title}}</view>
          <view class="goods-bottom">
            <text class="goods-price">{{item.priceDisplay}}</text>
            <view class="goods-status" style="background: {{item.statusColor}}20; color: {{item.statusColor}};">
              {{item.statusText}}
            </view>
          </view>
          <view class="goods-extra">
            <text class="view-count">👁 {{item.viewCount}}</text>
            <text class="time">{{item.timeText}}</text>
          </view>
        </view>
      </view>

      <!-- 操作按钮（独立区域，不被遮挡） -->
      <view class="goods-actions">
        <view
          class="action-btn edit-btn"
          data-id="{{item.itemId}}"
          catchtap="onEdit"
        >
          <text>编辑</text>
        </view>
        <view
          class="action-btn offline-btn"
          wx:if="{{item.status === 1}}"
          data-id="{{item.itemId}}"
          data-title="{{item.title}}"
          catchtap="onTakeOffline"
        >
          <text>下架</text>
        </view>
        <view
          class="action-btn relist-btn"
          wx:if="{{item.status === 4}}"
          data-id="{{item.itemId}}"
          catchtap="onRelist"
        >
          <text>重新上架</text>
        </view>
      </view>
    </view>
  </view>
</view>
