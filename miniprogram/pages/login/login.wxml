<view class="container">
  <view class="card">
    <view class="title">欢迎来到校园二手</view>
    <input class="input" placeholder="手机号" maxlength="11" value="{{phone}}" bindinput="onPhoneInput" />
    <input class="input" placeholder="密码" password value="{{password}}" bindinput="onPasswordInput" />
    <button class="btn-primary" loading="{{loading}}" bindtap="onSubmit">登录</button>
    <view class="row-links">
      <text bindtap="goRegister">注册 / 修改密码</text>
      <text bindtap="onWxLogin">微信登录</text>
    </view>
  </view>
</view>
