.container {
  padding: 40rpx 26rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #f0fdfa 0%, #ffffff 100%);
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  color: #115e59;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #64748b;
  margin-bottom: 32rpx;
}

/* 登录模式切换 */
.mode-tabs {
  display: flex;
  background: #f1f5f9;
  border-radius: 12rpx;
  margin-bottom: 32rpx;
  overflow: hidden;
}

.mode-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #64748b;
  transition: all 0.3s;
}

.mode-tab.active {
  background: #0f766e;
  color: #fff;
  font-weight: 600;
}

/* 微信登录按钮 */
.btn-wx {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: #07c160;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
  padding: 24rpx 0;
  border: none;
}

.btn-wx::after {
  border: none;
}

.wx-icon {
  width: 40rpx;
  height: 40rpx;
}

/* 分割线 */
.divider {
  display: flex;
  align-items: center;
  margin: 40rpx 0;
}

.line {
  flex: 1;
  height: 1rpx;
  background: #e2e8f0;
}

.divider-text {
  padding: 0 24rpx;
  font-size: 24rpx;
  color: #94a3b8;
}

/* 邮箱登录表单 */
.form-group {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 链接 */
.row-links {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  margin-top: 24rpx;
}

.link {
  color: #0f766e;
  font-size: 26rpx;
}

/* 提示 */
.tips {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin-top: 48rpx;
  padding: 20rpx;
  background: #f0fdfa;
  border-radius: 12rpx;
}

.tips-icon {
  font-size: 28rpx;
}

.tips-text {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.5;
}

/* ==================== 新用户引导 ==================== */

.guide-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.guide-card {
  width: 85%;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 36rpx;
  text-align: center;
}

.guide-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #115e59;
  margin-bottom: 8rpx;
}

.guide-subtitle {
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 36rpx;
}

/* 头像 */
.guide-avatar-wrap {
  margin-bottom: 32rpx;
}

.avatar-btn {
  position: relative;
  display: inline-block;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: normal;
}

.avatar-btn::after {
  border: none;
}

.guide-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #dbeafe;
  border: 4rpx solid #0f766e;
}

.avatar-edit {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 48rpx;
  height: 48rpx;
  background: #0f766e;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

/* 字段 */
.guide-field {
  text-align: left;
  margin-bottom: 24rpx;
}

.guide-label {
  font-size: 26rpx;
  color: #475569;
  margin-bottom: 8rpx;
  display: block;
}

.guide-input {
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
}

.guide-picker {
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.picker-arrow {
  font-size: 20rpx;
  color: #94a3b8;
}

/* 跳过 */
.guide-skip {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #94a3b8;
  padding: 12rpx;
}
