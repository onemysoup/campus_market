.container {
  min-height: 100vh;
  background: #f8fafc;
}

/* ==================== Tab 栏 ==================== */
.tabs {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #f1f5f9;
  overflow-x: auto;
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
  min-width: 120rpx;
  color: #64748b;
  font-size: 22rpx;
  position: relative;
  transition: all 0.3s;
}

.tab.active {
  color: #0f766e;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 20%;
  right: 20%;
  height: 4rpx;
  background: #0f766e;
  border-radius: 999rpx;
}

.tab-icon {
  font-size: 36rpx;
  margin-bottom: 4rpx;
}

/* ==================== 仪表盘 ==================== */
.section {
  padding: 24rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.stat-card.highlight {
  background: linear-gradient(135deg, #fef3c7, #fde68a);
}

.stat-value {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #64748b;
}

.today-stats {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  justify-content: space-around;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.today-item {
  text-align: center;
}

.today-value {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #0f766e;
  margin-bottom: 8rpx;
}

.today-label {
  font-size: 22rpx;
  color: #64748b;
}

/* ==================== 列表头部 ==================== */
.list-header {
  margin-bottom: 16rpx;
}

.list-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
}

/* ==================== 用户卡片 ==================== */
.user-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.user-info {
  margin-bottom: 16rpx;
}

.user-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
  display: block;
}

.user-email {
  font-size: 24rpx;
  color: #64748b;
  display: block;
  margin-top: 4rpx;
}

.user-tags {
  display: flex;
  gap: 8rpx;
  margin-top: 12rpx;
}

.tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.auth-0 { background: #f1f5f9; color: #64748b; }
.auth-1 { background: #dcfce7; color: #16a34a; }
.auth-2 { background: #dbeafe; color: #2563eb; }
.credit { background: #fef3c7; color: #d97706; }
.banned { background: #fee2e2; color: #dc2626; }

.user-actions {
  display: flex;
  gap: 12rpx;
}

.action-btn {
  flex: 1;
  text-align: center;
  padding: 12rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.action-btn.ban { background: #fee2e2; color: #dc2626; }
.action-btn.unban { background: #dcfce7; color: #16a34a; }
.action-btn.credit { background: #dbeafe; color: #2563eb; }
.action-btn.offline { background: #fee2e2; color: #dc2626; }
.action-btn.detail { background: #f0fdfa; color: #0f766e; }
.action-btn.accept { background: #dcfce7; color: #16a34a; }
.action-btn.reject { background: #fee2e2; color: #dc2626; }

/* ==================== 商品卡片 ==================== */
.item-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.item-info {
  margin-bottom: 16rpx;
}

.item-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
  display: block;
}

.item-meta {
  display: flex;
  gap: 12rpx;
  align-items: center;
  margin-top: 8rpx;
}

.item-price { font-size: 28rpx; font-weight: 700; color: #dc2626; }
.item-category { font-size: 22rpx; color: #0f766e; background: #f0fdfa; padding: 2rpx 10rpx; border-radius: 6rpx; }
.item-status { font-size: 22rpx; font-weight: 500; }
.item-time { font-size: 22rpx; color: #94a3b8; display: block; margin-top: 8rpx; }

.item-actions {
  display: flex;
  gap: 12rpx;
}

/* ==================== 举报卡片 ==================== */
.report-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.report-info {
  margin-bottom: 16rpx;
}

.report-reason {
  font-size: 28rpx;
  font-weight: 600;
  color: #dc2626;
  display: block;
}

.report-desc {
  font-size: 26rpx;
  color: #475569;
  display: block;
  margin-top: 8rpx;
}

.report-time {
  font-size: 22rpx;
  color: #94a3b8;
  display: block;
  margin-top: 8rpx;
}

.report-actions {
  display: flex;
  gap: 12rpx;
}

.empty {
  text-align: center;
  padding: 60rpx;
  color: #94a3b8;
  font-size: 28rpx;
}

/* ==================== 弹窗 ==================== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 85%;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
  text-align: center;
  margin-bottom: 8rpx;
}

.modal-subtitle {
  font-size: 26rpx;
  color: #64748b;
  text-align: center;
  margin-bottom: 24rpx;
}

.form-item {
  margin-bottom: 20rpx;
}

.form-label {
  font-size: 26rpx;
  color: #475569;
  margin-bottom: 8rpx;
  display: block;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 16rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 16rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.btn-cancel {
  flex: 1;
  background: #f1f5f9;
  color: #64748b;
}

.btn-confirm {
  flex: 1;
  background: #0f766e;
  color: #fff;
}

/* ==================== 无权限 ==================== */
.no-permission {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.lock-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.no-perm-text {
  font-size: 30rpx;
  color: #64748b;
}
