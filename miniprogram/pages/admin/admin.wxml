<view class="container" wx:if="{{isAdmin}}">
  <!-- Tab 栏 -->
  <view class="tabs">
    <view
      class="tab {{activeTab === item.key ? 'active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      data-tab="{{item.key}}"
      bindtap="onTabChange"
    >
      <text class="tab-icon">{{item.icon}}</text>
      <text class="tab-text">{{item.label}}</text>
    </view>
  </view>

  <!-- 仪表盘 -->
  <view class="section" wx:if="{{activeTab === 'dashboard'}}">
    <view class="stats-grid">
      <view class="stat-card">
        <text class="stat-value">{{dashboard.totalUsers || 0}}</text>
        <text class="stat-label">总用户</text>
      </view>
      <view class="stat-card">
        <text class="stat-value">{{dashboard.totalItems || 0}}</text>
        <text class="stat-label">总商品</text>
      </view>
      <view class="stat-card">
        <text class="stat-value">{{dashboard.activeItems || 0}}</text>
        <text class="stat-label">在售商品</text>
      </view>
      <view class="stat-card highlight">
        <text class="stat-value">{{dashboard.pendingReports || 0}}</text>
        <text class="stat-label">待处理举报</text>
      </view>
      <view class="stat-card verify-highlight">
        <text class="stat-value">{{dashboard.pendingVerifications || 0}}</text>
        <text class="stat-label">待审认证</text>
      </view>
    </view>
    <view class="today-stats">
      <view class="today-item">
        <text class="today-value">{{dashboard.todayNewUsers || 0}}</text>
        <text class="today-label">今日新增用户</text>
      </view>
      <view class="today-item">
        <text class="today-value">{{dashboard.todayNewItems || 0}}</text>
        <text class="today-label">今日新增商品</text>
      </view>
      <view class="today-item">
        <text class="today-value">{{dashboard.todayTransactions || 0}}</text>
        <text class="today-label">今日交易</text>
      </view>
    </view>

    <view class="analytics-panel">
      <view class="analytics-header">
        <text class="analytics-title">运营报表</text>
        <button class="export-btn" size="mini" bindtap="onExportStats">复制CSV</button>
      </view>

      <view class="filter-row">
        <view class="period-tabs">
          <view
            class="period-tab {{statsFilter.period === item.key ? 'active' : ''}}"
            wx:for="{{statsPeriods}}"
            wx:key="key"
            data-period="{{item.key}}"
            bindtap="onStatsPeriodChange"
          >
            {{item.label}}
          </view>
        </view>
        <picker mode="selector" range="{{statsCampusOptions}}" value="{{statsFilter.campusIndex}}" bindchange="onStatsCampusChange">
          <view class="campus-picker">{{statsCampusOptions[statsFilter.campusIndex]}}</view>
        </picker>
      </view>

      <view class="date-row" wx:if="{{statsFilter.period === 'day' || statsFilter.period === 'custom'}}">
        <picker mode="date" value="{{statsFilter.startDate}}" data-field="startDate" bindchange="onStatsDateChange" wx:if="{{statsFilter.period === 'custom'}}">
          <view class="date-picker">开始 {{statsFilter.startDate}}</view>
        </picker>
        <picker mode="date" value="{{statsFilter.endDate}}" data-field="endDate" bindchange="onStatsDateChange">
          <view class="date-picker">{{statsFilter.period === 'day' ? '日期' : '结束'}} {{statsFilter.endDate}}</view>
        </picker>
      </view>

      <view class="analytics-grid">
        <view class="metric-card">
          <text class="metric-value">{{analytics.summary.newUsers || 0}}</text>
          <text class="metric-label">新增用户</text>
        </view>
        <view class="metric-card">
          <text class="metric-value">{{analytics.summary.newItems || 0}}</text>
          <text class="metric-label">发布商品</text>
        </view>
        <view class="metric-card">
          <text class="metric-value">{{analytics.summary.completedTransactions || 0}}</text>
          <text class="metric-label">完成交易</text>
        </view>
        <view class="metric-card">
          <text class="metric-value">{{analytics.summary.dealRateText || '0%'}}</text>
          <text class="metric-label">成交率</text>
        </view>
        <view class="metric-card">
          <text class="metric-value">¥{{analytics.summary.turnoverText || '0.00'}}</text>
          <text class="metric-label">成交金额</text>
        </view>
        <view class="metric-card">
          <text class="metric-value">{{analytics.summary.activeUsers || 0}}</text>
          <text class="metric-label">活跃用户</text>
        </view>
      </view>

      <view class="report-block">
        <view class="report-title">校区对比</view>
        <view class="campus-row" wx:for="{{analytics.campus}}" wx:key="campusArea">
          <text class="campus-name">{{item.campusText}}</text>
          <text class="campus-metric">用户 {{item.newUsers}}</text>
          <text class="campus-metric">发布 {{item.newItems}}</text>
          <text class="campus-metric">交易 {{item.completedTransactions}}</text>
        </view>
        <view class="empty compact" wx:if="{{analytics.campus.length === 0}}">暂无校区数据</view>
      </view>

      <view class="report-block">
        <view class="report-title">分类表现</view>
        <view class="category-row" wx:for="{{analytics.categories}}" wx:key="category">
          <view class="category-main">
            <text class="category-name">{{item.categoryText}}</text>
            <text class="category-sub">浏览 {{item.viewCount}} · 收藏 {{item.favoriteCount}} · 私聊 {{item.chatCount}}</text>
          </view>
          <view class="category-side">
            <text>{{item.publishedCount}} 发布</text>
            <text>{{item.dealRateText}}</text>
          </view>
        </view>
        <view class="empty compact" wx:if="{{analytics.categories.length === 0}}">暂无分类数据</view>
      </view>

      <view class="report-block">
        <view class="report-title">热门商品</view>
        <view class="top-row" wx:for="{{analytics.topItems}}" wx:key="itemId">
          <text class="top-rank">{{index + 1}}</text>
          <view class="top-main">
            <text class="top-title">{{item.title}}</text>
            <text class="top-sub">{{item.categoryText}} · 浏览 {{item.viewCount}} · 收藏 {{item.favoriteCount}} · 私聊 {{item.chatCount}}</text>
          </view>
        </view>
        <view class="empty compact" wx:if="{{analytics.topItems.length === 0}}">暂无热门商品</view>
      </view>

      <!-- 搜索关键词云 -->
      <view class="report-block">
        <view class="report-title">搜索热词云</view>
        <view class="keyword-cloud">
          <text class="keyword-tag" wx:for="{{analytics.searchKeywords}}" wx:key="keyword"
                style="font-size: {{item.fontSize}}rpx;">{{item.keyword}}（{{item.count}}）</text>
        </view>
        <view class="empty compact" wx:if="{{analytics.searchKeywords.length === 0}}">暂无搜索数据</view>
      </view>

      <!-- 页面点击量 -->
      <view class="report-block">
        <view class="report-title">页面点击量</view>
        <view class="category-row" wx:for="{{analytics.pageClicks}}" wx:key="pageCode">
          <view class="category-main">
            <text class="category-name">{{item.pageText}}</text>
          </view>
          <view class="category-side">
            <text>{{item.clicks}} 次</text>
          </view>
        </view>
        <view class="empty compact" wx:if="{{analytics.pageClicks.length === 0}}">暂无点击数据</view>
      </view>

      <!-- 学院热度排行 -->
      <view class="report-block">
        <view class="report-title">学院热度排行</view>
        <view class="category-row" wx:for="{{analytics.colleges}}" wx:key="college">
          <view class="category-main">
            <text class="category-name">{{index + 1}}. {{item.collegeText}}</text>
            <text class="category-sub">发布 {{item.publishedCount}} · 求购 {{item.requestCount}}</text>
          </view>
          <view class="category-side">
            <text>{{item.totalCount}} 热度</text>
          </view>
        </view>
        <view class="empty compact" wx:if="{{analytics.colleges.length === 0}}">暂无学院数据</view>
      </view>
    </view>
  </view>

  <!-- 用户管理 -->
  <view class="section" wx:if="{{activeTab === 'users'}}">
    <view class="list-header">
      <text class="list-title">用户列表</text>
    </view>
    <view class="user-list">
      <view class="user-card" wx:for="{{users}}" wx:key="userId">
        <view class="user-info">
          <text class="user-name">{{item.nickname}}</text>
          <text class="user-email">{{item.email || '未绑定邮箱'}}</text>
          <view class="user-tags">
            <text class="tag auth-{{item.authLevel}}">L{{item.authLevel}}</text>
            <text class="tag credit">信用: {{item.creditScore}}</text>
            <text class="tag banned" wx:if="{{item.isBanned}}">已封禁</text>
          </view>
        </view>
        <view class="user-actions">
          <view
            class="action-btn {{item.isBanned ? 'unban' : 'ban'}}"
            data-userid="{{item.userId}}"
            data-nickname="{{item.nickname}}"
            data-banned="{{item.isBanned}}"
            catchtap="onToggleBan"
          >
            {{item.isBanned ? '解封' : '封禁'}}
          </view>
          <view
            class="action-btn credit"
            data-userid="{{item.userId}}"
            data-nickname="{{item.nickname}}"
            catchtap="onAdjustCredit"
          >
            调整信用
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 商品管理 -->
  <view class="section" wx:if="{{activeTab === 'items'}}">
    <view class="list-header">
      <text class="list-title">商品列表</text>
    </view>
    <view class="item-list">
      <view class="item-card" wx:for="{{items}}" wx:key="itemId">
        <view class="item-info">
          <text class="item-title">{{item.title}}</text>
          <view class="item-meta">
            <text class="item-price">{{item.priceDisplay}}</text>
            <text class="item-category">{{item.categoryText}}</text>
            <text class="item-status" style="color: {{item.statusColor}};">{{item.statusText}}</text>
          </view>
          <text class="item-time">{{item.timeText}}</text>
        </view>
        <view class="item-actions">
          <view
            class="action-btn offline"
            wx:if="{{item.status === 1}}"
            data-itemid="{{item.itemId}}"
            data-title="{{item.title}}"
            catchtap="onTakeOffline"
          >
            下架
          </view>
          <view class="action-btn detail" data-id="{{item.itemId}}" catchtap="goDetail">
            详情
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 认证审核 -->
  <view class="section" wx:if="{{activeTab === 'verifications'}}">
    <view class="list-header">
      <text class="list-title">L2 认证审核</text>
    </view>
    <view class="verification-list">
      <view class="verification-card" wx:for="{{verifications}}" wx:key="id">
        <view class="verification-main">
          <image
            class="proof-thumb"
            src="{{item.proofUrl}}"
            mode="aspectFill"
            data-url="{{item.proofUrl}}"
            bindtap="onPreviewVerificationImage"
          />
          <view class="verification-info">
            <text class="verification-name">{{item.realName}}</text>
            <text class="verification-meta">学号：{{item.studentId}}</text>
            <text class="verification-meta">邮箱：{{item.email || '未绑定邮箱'}}</text>
            <text class="verification-time">{{item.timeText}}</text>
          </view>
        </view>
        <view class="verification-actions">
          <view
            class="action-btn accept"
            data-applicationid="{{item.id}}"
            data-realname="{{item.realName}}"
            data-approve="true"
            catchtap="onHandleVerification"
          >
            通过
          </view>
          <view
            class="action-btn reject"
            data-applicationid="{{item.id}}"
            data-realname="{{item.realName}}"
            data-approve="false"
            catchtap="onHandleVerification"
          >
            驳回
          </view>
        </view>
      </view>
      <view class="empty" wx:if="{{verifications.length === 0 && !loadingVerifications}}">
        暂无待审核认证
      </view>
    </view>
  </view>

  <!-- 举报处理 -->
  <view class="section" wx:if="{{activeTab === 'reports'}}">
    <view class="list-header">
      <text class="list-title">待处理举报</text>
    </view>
    <view class="report-list">
      <view class="report-card" wx:for="{{reports}}" wx:key="id">
        <view class="report-info">
          <text class="report-reason">{{item.reasonText}}</text>
          <text class="report-desc">{{item.description || '无描述'}}</text>
          <text class="report-time">{{item.timeText}}</text>
        </view>
        <view class="report-actions">
          <view
            class="action-btn accept"
            data-reportid="{{item.id}}"
            data-accept="true"
            catchtap="onHandleReport"
          >
            接受
          </view>
          <view
            class="action-btn reject"
            data-reportid="{{item.id}}"
            data-accept="false"
            catchtap="onHandleReport"
          >
            驳回
          </view>
        </view>
      </view>
      <view class="empty" wx:if="{{reports.length === 0 && !loadingReports}}">
        暂无待处理举报
      </view>
    </view>
  </view>

  <!-- 信用分调整弹窗 -->
  <view class="modal-mask" wx:if="{{showActionModal}}" bindtap="onCloseModal">
    <view class="modal-content" catchtap="onStopPropagation">
      <view class="modal-title">调整信用分</view>
      <view class="modal-subtitle">用户：{{actionData.nickname}}</view>
      <view class="modal-body">
        <view class="form-item">
          <text class="form-label">调整分值（正数加分，负数扣分）</text>
          <input class="form-input" type="number" placeholder="例：-10 或 +5" value="{{creditForm.delta}}" bindinput="onCreditDeltaInput" />
        </view>
        <view class="form-item">
          <text class="form-label">调整原因</text>
          <textarea class="form-textarea" placeholder="请输入调整原因" value="{{creditForm.reason}}" bindinput="onCreditReasonInput" />
        </view>
      </view>
      <view class="modal-footer">
        <button class="btn-cancel" bindtap="onCloseModal">取消</button>
        <button class="btn-confirm" loading="{{actionLoading}}" bindtap="onSubmitCredit">确认</button>
      </view>
    </view>
  </view>
</view>

<!-- 无权限 -->
<view class="no-permission" wx:if="{{!isAdmin && !loading}}">
  <text class="lock-icon">🔒</text>
  <text class="no-perm-text">仅管理员可访问</text>
</view>
