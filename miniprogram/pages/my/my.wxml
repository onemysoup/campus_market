<view class="container">
  <!-- 已登录 -->
  <block wx:if="{{isLoggedIn}}">
    <!-- 用户卡片 -->
    <view class="card profile">
      <image class="avatar" src="{{user.avatarUrl || fallback}}" mode="aspectFill" />
      <view class="name">{{user.nickname || '未设置昵称'}}</view>

      <!-- 认证等级徽章 -->
      <view class="badges">
        <view class="badge admin-badge" wx:if="{{isAdmin}}">管理员</view>
        <view class="badge" style="background: {{authLevelColor}}20; color: {{authLevelColor}}; border: 1rpx solid {{authLevelColor}}40;">
          {{authLevelLabel}}
        </view>
        <view class="badge badge-credit" wx:if="{{creditScore > 0}}">
          ⭐ {{creditScore}}分 · {{creditTier}}
        </view>
      </view>
    </view>

    <!-- 管理员菜单 -->
    <view class="card menu-card" wx:if="{{isAdmin}}">
      <view class="menu-item" bindtap="goAdmin">
        <text class="menu-icon">📊</text>
        <text class="menu-text">管理后台</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goAdminUsers">
        <text class="menu-icon">👥</text>
        <text class="menu-text">用户管理</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goAdminItems">
        <text class="menu-icon">📦</text>
        <text class="menu-text">商品管理</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goAdminReports">
        <text class="menu-icon">🚨</text>
        <text class="menu-text">举报处理</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onEditProfile">
        <text class="menu-icon">⚙️</text>
        <text class="menu-text">账号设置</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <!-- 普通用户菜单 -->
    <view class="card menu-card" wx:if="{{!isAdmin}}">
      <view class="menu-item" bindtap="goOrders">
        <text class="menu-icon">📦</text>
        <text class="menu-text">我的订单</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goMyGoods">
        <text class="menu-icon">🏷️</text>
        <text class="menu-text">我发布的商品</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goFavorites">
        <text class="menu-icon">❤️</text>
        <text class="menu-text">我的收藏</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onEditProfile">
        <text class="menu-icon">⚙️</text>
        <text class="menu-text">账号设置</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <!-- 退出按钮 -->
    <view class="card">
      <button class="btn-logout" bindtap="logout">退出登录</button>
    </view>
  </block>

  <!-- 未登录 -->
  <block wx:if="{{!isLoggedIn}}">
    <view class="card empty-card">
      <text class="empty-icon">👤</text>
      <view class="empty-title">登录后查看更多</view>
      <view class="empty-desc">登录后可查看订单、收藏和发布管理</view>
      <button class="btn-primary" bindtap="goLogin">去登录</button>
    </view>
  </block>
</view>
