.container {
  padding: 24rpx;
  min-height: 100vh;
  background: #f8fafc;
}

/* 用户卡片 */
.profile {
  text-align: center;
  padding: 40rpx 24rpx;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #dbeafe;
  border: 4rpx solid #0f766e;
}

.name {
  font-size: 40rpx;
  font-weight: 700;
  color: #115e59;
  margin-top: 16rpx;
}

/* 徽章 */
.badges {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin-top: 16rpx;
  flex-wrap: wrap;
}

.badge {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.admin-badge {
  background: linear-gradient(135deg, #f59e0b, #d97706);
  color: #fff;
  border: none;
}

.badge-credit {
  background: #fef3c7;
  color: #92400e;
  border: 1rpx solid #fcd34d;
}

/* 菜单卡片 */
.menu-card {
  padding: 0;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f1f5f9;
  transition: background 0.2s;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: #f8fafc;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #334155;
}

.menu-arrow {
  font-size: 36rpx;
  color: #cbd5e1;
}

/* 退出按钮 */
.btn-logout {
  background: #fff;
  color: #ef4444;
  font-size: 30rpx;
  border: 1rpx solid #fecaca;
  border-radius: 12rpx;
}

.btn-logout::after {
  border: none;
}

/* 空状态 */
.empty-card {
  text-align: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
  display: block;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #334155;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #94a3b8;
  margin-bottom: 36rpx;
}
