.banner { width: 100%; height: 420rpx; border-radius: 16rpx; background: #e2e8f0; }
.title { font-size: 36rpx; font-weight: 700; margin-top: 18rpx; }
.price { color: #dc2626; font-size: 42rpx; font-weight: 700; margin-top: 8rpx; }
.desc { margin-top: 14rpx; color: #334155; line-height: 1.7; }
.seller { margin-top: 12rpx; color: #0f766e; }
.actions { display: flex; gap: 10rpx; }
.actions button { flex: 1; }
