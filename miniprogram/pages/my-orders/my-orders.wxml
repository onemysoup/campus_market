<view class="container">
  <app-nav title="我的订单" showBack />
  <!-- 主 Tab：买入/卖出 -->
  <view class="main-tabs">
    <view
      class="main-tab {{mainTab === item.key ? 'active' : ''}}"
      wx:for="{{mainTabs}}"
      wx:key="key"
      data-tab="{{item.key}}"
      bindtap="onMainTabChange"
    >
      <text class="tab-text">{{item.label}}</text>
    </view>
  </view>

  <!-- 状态筛选 Tab -->
  <view class="status-tabs">
    <view
      class="status-tab {{statusTab === item.key ? 'active' : ''}}"
      wx:for="{{statusTabs}}"
      wx:key="key"
      data-status="{{item.key}}"
      bindtap="onStatusTabChange"
    >
      <text>{{item.label}}</text>
      <text class="badge" wx:if="{{item.key === 0 && stats.trading > 0}}">{{stats.trading}}</text>
    </view>
  </view>

  <!-- 订单列表 -->
  <view class="order-list">
    <!-- 骨架屏 -->
    <view class="skeleton-list" wx:if="{{loading && list.length === 0}}">
      <view class="skeleton-item" wx:for="{{[1,2,3]}}" wx:key="*this">
        <view class="skeleton-header"></view>
        <view class="skeleton-body">
          <view class="skeleton-thumb"></view>
          <view class="skeleton-meta">
            <view class="skeleton-title"></view>
            <view class="skeleton-price"></view>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:elif="{{!loading && list.length === 0}}">
      <text class="empty-icon">📦</text>
      <text class="empty-text">暂无{{mainTab === 'buyer' ? '买入' : '卖出'}}订单</text>
    </view>

    <!-- 订单卡片 -->
    <view
      class="order-card"
      wx:for="{{list}}"
      wx:key="transactionId"
    >
      <!-- 卡片头部：状态 + 时间 -->
      <view class="order-header">
        <view class="order-status" style="background: {{item.statusBg}}; color: {{item.statusColor}};">
          {{item.statusText}}
        </view>
        <text class="order-time">{{item.timeText}}</text>
      </view>

      <!-- 卡片主体：商品信息 -->
      <view class="order-body" data-itemid="{{item.itemId}}" bindtap="onTapOrder">
        <image wx:if="{{item.firstImage}}" class="order-thumb" src="{{item.firstImage}}" mode="aspectFill" />
        <view wx:else class="order-thumb thumb-placeholder">暂无图片</view>
        <view class="order-meta">
          <view class="order-title">{{item.title}}</view>
          <view class="order-info">
            <text class="order-price">{{item.priceDisplay}}</text>
            <text class="order-type">{{item.transactionType === 1 ? '租赁' : '出售'}}</text>
          </view>
        </view>
      </view>

      <!-- 取货码区域（仅买家可见，交易中状态） -->
      <view class="pickup-code-section" wx:if="{{mainTab === 'buyer' && item.pickupCode && item.status === 0}}">
        <view class="pickup-label">{{item.isRental ? '🔑 借出核销码（请出示给卖家）' : '🔑 取货码（请出示给卖家）'}}</view>
        <view class="pickup-code">{{item.pickupCode}}</view>
        <view class="pickup-tip">{{item.isRental ? '线下交押金/租金后，卖家输入此码开始租期' : '交易时请将此码提供给卖家核销'}}</view>
      </view>

      <!-- 租赁归还码区域（仅卖家可见，租赁中状态） -->
      <view class="pickup-code-section return-code-section" wx:if="{{mainTab === 'seller' && item.isRental && item.rentalStatus === 1 && item.rentalReturnCode && item.status === 0}}">
        <view class="pickup-label">🔁 归还确认码（归还时出示给买家）</view>
        <view class="pickup-code">{{item.rentalReturnCode}}</view>
        <view class="pickup-tip">买家归还物品时输入此码，订单完成</view>
      </view>

      <!-- 卡片底部：操作按钮 -->
      <view class="order-footer">
        <view class="order-other">
          <text class="other-label">{{mainTab === 'buyer' ? '卖家' : '买家'}}：</text>
          <text class="other-name">{{item.otherNickname || '未知用户'}}</text>
        </view>
        <view class="order-actions">
          <!-- 交易中：可取消、可联系 -->
          <block wx:if="{{item.status === 0}}">
            <button
              class="btn-action btn-cancel"
              size="mini"
              data-transactionid="{{item.transactionId}}"
              catchtap="onCancelTransaction"
            >取消</button>
            <button
              class="btn-action btn-contact"
              size="mini"
              data-otherid="{{mainTab === 'buyer' ? item.sellerId : item.buyerId}}"
              data-itemid="{{item.itemId}}"
              data-othername="{{item.otherNickname || '对方'}}"
              catchtap="onContact"
            >联系</button>
            <!-- 卖家核销入口 -->
            <button
              class="btn-action btn-verify"
              size="mini"
              wx:if="{{mainTab === 'seller' && !item.isRental}}"
              data-transactionid="{{item.transactionId}}"
              catchtap="onVerifyPickup"
            >核销取货码</button>
            <!-- 租赁：卖家借出核销 -->
            <button
              class="btn-action btn-verify"
              size="mini"
              wx:if="{{mainTab === 'seller' && item.isRental && item.rentalStatus === 0}}"
              data-transactionid="{{item.transactionId}}"
              catchtap="onStartRental"
            >借出核销</button>
            <!-- 租赁：买家归还核销 -->
            <button
              class="btn-action btn-verify"
              size="mini"
              wx:if="{{mainTab === 'buyer' && item.isRental && (item.rentalStatus === 1 || item.rentalStatus === 2)}}"
              data-transactionid="{{item.transactionId}}"
              catchtap="onCompleteRentalReturn"
            >归还核销</button>
            <!-- 买家取货凭证（可截图代领） -->
            <button
              class="btn-action btn-contact"
              size="mini"
              wx:if="{{mainTab === 'buyer' && item.pickupCode}}"
              data-code="{{item.pickupCode}}"
              data-title="{{item.itemTitle}}"
              data-location="{{item.agreedLocation}}"
              catchtap="onShowVoucher"
            >取货凭证</button>
          </block>
          <!-- 已完成/已取消：可联系 -->
          <block wx:if="{{item.status !== 0}}">
            <button
              class="btn-action btn-contact"
              size="mini"
              data-otherid="{{mainTab === 'buyer' ? item.sellerId : item.buyerId}}"
              data-itemid="{{item.itemId}}"
              data-othername="{{item.otherNickname || '对方'}}"
              catchtap="onContact"
            >联系对方</button>
            <!-- 已完成：可评价 -->
            <button
              class="btn-action btn-verify"
              size="mini"
              wx:if="{{item.status === 1}}"
              data-transactionid="{{item.transactionId}}"
              catchtap="onReview"
            >评价</button>
          </block>
        </view>
      </view>
    </view>

    <!-- 加载更多 -->
    <view class="loading-more" wx:if="{{loadingMore}}">
      <view class="loading-spinner"></view>
      <text>加载中...</text>
    </view>

    <!-- 没有更多数据 -->
    <view class="no-more" wx:if="{{!hasMore && list.length > 0 && !loadingMore}}">
      <text>— 已经到底了 —</text>
    </view>
  </view>

  <!-- 取货凭证卡片（F4.2.2，可截图发给代领人） -->
  <view class="voucher-mask" wx:if="{{showVoucher}}" catchtap="onCloseVoucher">
    <view class="voucher-card" catchtap="stopPropagation">
      <view class="voucher-title">取货凭证</view>
      <image class="voucher-image" wx:if="{{voucher.image}}" src="{{voucher.image}}" mode="aspectFill" />
      <view class="voucher-goods">{{voucher.title}}</view>
      <view class="voucher-code">{{voucher.code}}</view>
      <view class="voucher-label">取货码</view>
      <view class="voucher-location">📍 {{voucher.location}}</view>
      <view class="voucher-hint">截图发给舍友/委托人即可凭码代领</view>
      <view class="voucher-close" catchtap="onCloseVoucher">关闭</view>
    </view>
  </view>
</view>
