.tabs { display: flex; margin-bottom: 16rpx; background: #e2e8f0; border-radius: 14rpx; overflow: hidden; }
.tab { flex: 1; text-align: center; padding: 14rpx 0; font-size: 24rpx; }
.tab.active { background: #0f766e; color: #fff; font-weight: 700; }
.actions { margin-top: 12rpx; display: flex; gap: 10rpx; }
.empty { text-align: center; color: #64748b; margin-top: 24rpx; }
