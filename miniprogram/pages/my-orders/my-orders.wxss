.container {
  min-height: 100vh;
  background: #f8fafc;
}

/* ==================== 主 Tab ==================== */
.main-tabs {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #f1f5f9;
}

.main-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
  font-size: 30rpx;
  color: #64748b;
  position: relative;
  transition: all 0.3s;
}

.main-tab.active {
  color: #0f766e;
  font-weight: 600;
}

.main-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 25%;
  right: 25%;
  height: 4rpx;
  background: #0f766e;
  border-radius: 999rpx;
}

/* ==================== 状态筛选 Tab ==================== */
.status-tabs {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #f1f5f9;
  overflow-x: auto;
}

.status-tab {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: #f1f5f9;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #475569;
  white-space: nowrap;
  transition: all 0.2s;
}

.status-tab.active {
  background: #0f766e;
  color: #fff;
}

.badge {
  font-size: 20rpx;
  background: #ef4444;
  color: #fff;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  min-width: 32rpx;
  text-align: center;
}

/* ==================== 订单列表 ==================== */
.order-list {
  padding: 16rpx 24rpx;
}

.order-card {
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

/* 卡片头部 */
.order-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.order-status {
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.order-time {
  font-size: 22rpx;
  color: #94a3b8;
}

/* 卡片主体 */
.order-body {
  display: flex;
  padding: 20rpx;
}

.order-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: #f1f5f9;
  flex-shrink: 0;
}

.order-meta {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.order-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.4;
}

.order-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.order-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #dc2626;
}

.order-type {
  font-size: 20rpx;
  color: #0f766e;
  background: #f0fdfa;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

/* 卡片底部 */
.order-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  border-top: 1rpx solid #f1f5f9;
}

.order-other {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.other-label {
  font-size: 22rpx;
  color: #94a3b8;
}

.other-name {
  font-size: 22rpx;
  color: #475569;
  font-weight: 500;
}

.order-actions {
  display: flex;
  gap: 12rpx;
}

.btn-action {
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  line-height: 1.5;
  min-height: 0;
}

.btn-action::after {
  border: none;
}

.btn-cancel {
  background: #f1f5f9;
  color: #64748b;
}

.btn-contact {
  background: #f0fdfa;
  color: #0f766e;
}

.btn-confirm {
  background: #0f766e;
  color: #fff;
}

/* ==================== 加载状态 ==================== */
.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 32rpx 0;
  color: #64748b;
  font-size: 26rpx;
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid #e2e8f0;
  border-top-color: #0f766e;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.no-more {
  text-align: center;
  padding: 32rpx 0;
  color: #94a3b8;
  font-size: 24rpx;
}

/* ==================== 骨架屏 ==================== */
.skeleton-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.skeleton-item {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.skeleton-header {
  height: 60rpx;
  background: linear-gradient(90deg, #f1f5f9 25%, #e2e8f0 50%, #f1f5f9 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}

.skeleton-body {
  display: flex;
  padding: 20rpx;
}

.skeleton-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: linear-gradient(90deg, #f1f5f9 25%, #e2e8f0 50%, #f1f5f9 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}

.skeleton-meta {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.skeleton-title {
  height: 36rpx;
  width: 80%;
  background: linear-gradient(90deg, #f1f5f9 25%, #e2e8f0 50%, #f1f5f9 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: 6rpx;
}

.skeleton-price {
  height: 40rpx;
  width: 30%;
  background: linear-gradient(90deg, #f1f5f9 25%, #e2e8f0 50%, #f1f5f9 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: 6rpx;
}

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ==================== 空状态 ==================== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 28rpx;
  color: #94a3b8;
}
