.container {
  padding: 24rpx;
  min-height: 100vh;
  background: #f8fafc;
}

.title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
  margin-bottom: 16rpx;
}

.reason-tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  background: #fee2e2;
  color: #dc2626;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 16rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.count {
  text-align: right;
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 8rpx;
}
