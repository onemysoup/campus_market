<view class="custom-nav" style="padding-top: {{statusBarHeight}}px;">
  <view class="custom-nav-bar" style="height: {{navBarHeight}}px;">
    <text class="custom-nav-title">校园二手首页</text>
  </view>
</view>

<view class="container">
  <!-- Hero Banner -->
  <view class="hero card">
    <view class="hero-title">校园闲置循环计划</view>
    <view class="hero-sub">买卖二手好物，省钱更环保</view>
  </view>

  <!-- 求购大厅入口 -->
  <view class="entry-card" bindtap="goRequests">
    <view class="entry-icon">📢</view>
    <view class="entry-text">
      <view class="entry-title">求购大厅</view>
      <view class="entry-sub">找不到想要的？发条求购让卖家来找你</view>
    </view>
    <view class="entry-arrow">›</view>
  </view>

  <!-- 分类导航 -->
  <view class="card">
    <view class="section-title">分类导航</view>
    <view class="grid">
      <view
        class="grid-item"
        wx:for="{{categories}}"
        wx:key="id"
        bindtap="goGoods"
        data-id="{{item.id}}"
      >
        <text>{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 热门商品 -->
  <view class="card">
    <view class="section-title">🔥 热门商品</view>
    <!-- 加载中 -->
    <view class="loading-wrap" wx:if="{{loading}}">
      <view class="loading-item" wx:for="{{[1,2,3]}}" wx:key="*this"></view>
    </view>
    <!-- 空状态 -->
    <view class="empty" wx:elif="{{hotGoods.length === 0}}">
      <text>暂无热门商品</text>
    </view>
    <!-- 商品列表 -->
    <view
      class="goods-item"
      wx:for="{{hotGoods}}"
      wx:key="itemId"
      bindtap="goDetail"
      data-id="{{item.itemId}}"
    >
      <image class="thumb" src="{{item.firstImage}}" mode="aspectFill" binderror="onImageError" />
      <view class="meta">
        <view class="goods-title">{{item.title}}</view>
        <view class="goods-info">
          <text class="category-tag">{{item.categoryText}}</text>
          <text class="view-count">👁 {{item.viewCount}}</text>
        </view>
        <view class="price">{{item.priceDisplay}}</view>
      </view>
    </view>
  </view>

  <!-- 最新发布 -->
  <view class="card">
    <view class="section-title">🆕 最新发布</view>
    <!-- 加载中 -->
    <view class="loading-wrap" wx:if="{{loading}}">
      <view class="loading-item" wx:for="{{[1,2,3]}}" wx:key="*this"></view>
    </view>
    <!-- 空状态 -->
    <view class="empty" wx:elif="{{latestGoods.length === 0}}">
      <text>暂无最新商品</text>
    </view>
    <!-- 商品列表 -->
    <view
      class="goods-item"
      wx:for="{{latestGoods}}"
      wx:key="itemId"
      bindtap="goDetail"
      data-id="{{item.itemId}}"
    >
      <image class="thumb" src="{{item.firstImage}}" mode="aspectFill" binderror="onImageError" />
      <view class="meta">
        <view class="goods-title">{{item.title}}</view>
        <view class="goods-info">
          <text class="category-tag">{{item.categoryText}}</text>
          <text class="time-text">{{item.timeText}}</text>
        </view>
        <view class="price">{{item.priceDisplay}}</view>
      </view>
    </view>
  </view>
</view>
