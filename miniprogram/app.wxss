page {
  background: linear-gradient(180deg, #f0fdfa 0%, #f8fafc 45%, #ffffff 100%);
  min-height: 100%;
  color: #0f172a;
}

.container {
  padding: 24rpx;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 12rpx 30rpx rgba(15, 23, 42, 0.08);
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.btn-primary {
  background: #0f766e;
  color: #ffffff;
  border-radius: 16rpx;
}

.input {
  background: #f8fafc;
  border: 1px solid #dbeafe;
  border-radius: 14rpx;
  padding: 18rpx;
  margin-bottom: 16rpx;
}

.tag {
  display: inline-block;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #ccfbf1;
  color: #0f766e;
  font-size: 24rpx;
}
